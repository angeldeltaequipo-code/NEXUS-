# =====================================================================
# NEXUS-LPR — Configuración del servidor
# Copie este archivo como .env y ajuste los valores.
# =====================================================================

# Puerto del panel y la API
PORT=3000

# Contraseña inicial del usuario "admin" (solo se usa la primera vez).
# Si la deja vacía, se genera una al azar y aparece en los logs:
#   docker compose logs nexus-server | grep contraseña
ADMIN_PASSWORD=

# Duración de la sesión del panel (horas)
SESSION_HOURS=12

# --- Retención de datos (Ley 21.719: plazos limitados y proporcionales) ---
# Lecturas normales (sin alerta)
RETENTION_DAYS=30
# Lecturas con alerta (y sus fotos de evidencia)
ALERT_RETENTION_DAYS=365
# Registro de auditoría
AUDIT_RETENTION_DAYS=730
# Respaldos diarios de la base de datos que se conservan
BACKUP_KEEP_DAYS=14

# Minutos sin señal para marcar una cámara como "SIN SEÑAL"
CAMERA_OFFLINE_MIN=3

# --- Alertas por Telegram (opcional, ver docs/GUIA_INSTALACION.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# No repetir aviso de la misma patente antes de N minutos
NOTIFY_COOLDOWN_MIN=5

# --- Acceso remoto por Cloudflare Tunnel (opcional) ---
CLOUDFLARE_TUNNEL_TOKEN=
