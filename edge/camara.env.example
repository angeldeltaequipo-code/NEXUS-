# =====================================================================
# NEXUS-LPR — Configuración de UNA cámara
# Copie como edge/camaras/camara-01.env (Docker) o edge/.env (sin Docker)
# =====================================================================

# Clave de la cámara: se genera en el panel (pestaña Cámaras) o con
#   docker compose exec nexus-server node scripts/agregar-camara.js CAM-EDGE-01 "Acceso norte" "Pasaje X - Linares"
NEXUS_API_KEY=

# Servidor (con Docker Compose se configura solo; sin Docker: http://localhost:3000)
NEXUS_API=http://localhost:3000

# Stream RTSP de la cámara. Ejemplos según marca (use el stream PRINCIPAL):
#   Hikvision:  rtsp://usuario:clave@192.168.1.64:554/Streaming/Channels/101
#   Dahua:      rtsp://usuario:clave@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0
#   Reolink:    rtsp://usuario:clave@192.168.1.50:554/h264Preview_01_main
#   Para probar sin cámara, un video grabado: /ruta/a/video.mp4
RTSP_URL=

# Motor OCR: rapidocr (recomendado, liviano) | easyocr
OCR_ENGINE=rapidocr

# Región de interés "x,y,ancho,alto" en fracciones de la imagen (0 a 1).
# Recortar a la zona donde pasan las patentes mejora velocidad y precisión.
# Ejemplo: mitad inferior central → 0.2,0.5,0.6,0.5   (vacío = imagen completa)
ROI=

# Cuadros analizados por segundo (3–5 en mini PC; 1–2 en Raspberry Pi)
FPS_PROCESS=3

# Confianza mínima del OCR (0–1)
MIN_CONF=0.60
# Lecturas iguales requeridas para confirmar una patente
CONFIRM_READS=2
# Con confianza igual o mayor a esta se confirma con una sola lectura
DIRECT_CONF=0.92
# No reenviar la misma patente antes de N segundos
DEDUP_SECONDS=30

# Latido al servidor (segundos) y reenvío de lecturas pendientes
HEARTBEAT_SECONDS=60

# Enviar foto de evidencia SOLO cuando hay alerta (true/false)
SAVE_EVIDENCE=true
